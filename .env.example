PORT=5000
# MongoDB connection string (replace <username>, <password>, <cluster> and <dbname>)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here

# NODE_ENV=development

# Notes:
# - Copy this file to `.env` in the project root before starting the backend server.
# - Make sure MongoDB is running or use a MongoDB Atlas connection string.